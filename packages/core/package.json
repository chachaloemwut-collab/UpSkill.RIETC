{
  "name": "@upskill/core",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./heartbeat": "./src/heartbeat.ts",
    "./user-agent": "./src/user-agent.ts",
    "./youtube": "./src/youtube.ts",
    "./cohort": "./src/cohort.ts",
    "./eligibility": "./src/eligibility.ts",
    "./profile": "./src/profile.ts",
    "./completion": "./src/completion.ts",
    "./application": "./src/application.ts"
