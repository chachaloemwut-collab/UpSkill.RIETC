{
  "name": "@upskill/db",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "migrate": "tsx --env-file-if-exists=../../.env.local src/migrate.ts",
    "codegen": "node --env-file-if-exists=../../.env.local ./node_modules/kysely-codegen/dist/cli/bin.js --dialect postgres --url 'env(DATABASE_MIGRATION_URL)' --exclude-pattern schema_migrations --out-file src/generated.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "kysely": "0.29.8",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "kysely-codegen": "0.20.0",
    "tsx": "4.23.15",
    "typescript": "~7.0.2"
  }
}
