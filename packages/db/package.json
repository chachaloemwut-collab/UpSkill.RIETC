{
  "name": "@upskill/db",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "migrate": "tsx src/migrate.ts",
    "codegen": "kysely-codegen --dialect postgres --url env(DATABASE_MIGRATION_URL) --out-file src/generated.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "kysely": "0.29.9",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@types/pg": "8.23.1",
    "kysely-codegen": "0.20.0",
    "tsx": "4.23.15",
    "typescript": "~6.0.3"
  }
}
