{
  "name": "@upskill/worker",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env.local src/index.ts",
    "start": "node --env-file-if-exists=../../.env.local --import tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test src/system-owner.test.ts src/jobs/certificate-template.test.ts",
    "seed": "tsx --env-file-if-exists=../../.env.local src/seed.ts",
    "seed:krathong": "tsx --env-file-if-exists=../../.env.local src/complete-krathong-flow.ts",
    "import:krathong-contest": "tsx --env-file-if-exists=../../.env.local src/import-krathong-contest.ts"
  },
  "dependencies": {
    "@upskill/core": "workspace:*",
    "@upskill/db": "workspace:*",
    "@upskill/infra": "workspace:*",
    "bullmq": "6.7.6",
    "playwright": "1.65.0",
    "qrcode": "1.5.4"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/qrcode": "1.5.6",
    "tsx": "4.23.15",
    "typescript": "~6.0.3"
  }
}
