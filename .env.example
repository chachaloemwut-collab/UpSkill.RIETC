# Copy to .env.local (never commit real values; .env* files are already in .gitignore)
# In production, inject from a Secret Manager (AWS SM / GCP SM / Vault), not from files.

# local | staging | production. Production enforces https + a YouTube API key.
APP_ENV=local
APP_ORIGIN=http://localhost:3000

# --- Database ---
# The app uses the least-privilege role (upskill_app); migrations use the owner role.
DATABASE_URL=postgres://upskill_app:dev_app_password@127.0.0.1:55432/upskill
DATABASE_MIGRATION_URL=postgres://upskill_owner:dev_owner_password@127.0.0.1:55432/upskill

# --- Redis ---
REDIS_URL=redis://:dev_redis_password@127.0.0.1:6379/0

# --- Google OAuth 2.0 (OIDC) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# --- Protected system owner ---
# This account signs in with a username, not an email. Keep the password only in
# the deployment secret store; the worker bootstraps it as an Argon2id hash.
SYSTEM_OWNER_USERNAME=superadmin
SYSTEM_OWNER_PASSWORD=

# --- YouTube Data API v3 (server only; restrict the key by server IP + YouTube Data API only) ---
YOUTUBE_API_KEY=

# --- Certificate signing (Ed25519) ---
# Generate with: pnpm keys:generate
# Rotation: add a new key and change CERT_SIGNING_ACTIVE_KID. Keep the old public keys
# in CERT_PUBLIC_KEYS forever, otherwise older certificates can no longer be verified.
CERT_SIGNING_ACTIVE_KID=
CERT_SIGNING_PRIVATE_KEY=
# JSON: {"<kid>":"<base64url SPKI DER public key>", ...}
CERT_PUBLIC_KEYS='{}'

# Certificate PDFs (shared by web + worker; both run from apps/<name>, so ../../ = repo root).
# Production: replace with object storage (private bucket).
CERT_STORAGE_DIR=../../var/certificates

# --- Email ---
SMTP_URL=smtp://127.0.0.1:1025
MAIL_FROM="UpskillReskill.RIETC <no-reply@localhost>"
# ใส่ค่าจากผู้ให้บริการอีเมลเมื่อเชื่อม webhook (อย่างน้อย 16 ตัวอักษร)
EMAIL_WEBHOOK_SECRET=
# 32 random bytes in base64url. Keep this value permanently; it encrypts SMTP
# credentials saved from the admin settings page.
SETTINGS_ENCRYPTION_KEY=
