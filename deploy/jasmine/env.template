# Template for the server-side .env of hosting "มะลิ (Jasmine)". NO real values in this file (it is committed).
# `scripts/deploy-jasmine.sh init` creates deploy/jasmine/secrets/.env from it with generated secrets;
# fill the remaining CHANGE_ME values there, then upload it once with `scripts/deploy-jasmine.sh upload-env`.

# staging until the domain has HTTPS and a YouTube API key exists, then switch to production
# (production refuses to start without https APP_ORIGIN + YOUTUBE_API_KEY).
APP_ENV=staging
# The public https URL once the admin binds the domain. Must match exactly (cookies, CSRF Origin check, OAuth).
APP_ORIGIN=https://CHANGE_ME.invalid

# --- PostgreSQL (one account: owns the schema and is used by the app) ---
# Reachable only on the Docker network uldkkd9ywqslup. URL-encode special characters in the password (? -> %3F).
DATABASE_URL=postgres://jasmine_db:CHANGE_ME@d2dlzpu27ix28y:24632/lpe1831zma9pmg
DATABASE_MIGRATION_URL=postgres://jasmine_db:CHANGE_ME@d2dlzpu27ix28y:24632/lpe1831zma9pmg
# This hosting cannot create the least-privilege roles: skip their GRANT/REVOKE statements (see docs/DEPLOY.md)
MIGRATION_SKIP_ROLE_GRANTS=1

# --- Redis (container "redis" in compose.yml) ---
REDIS_PASSWORD=CHANGE_ME
REDIS_URL=redis://:CHANGE_ME@redis:6379/0

# --- Google OAuth (optional; leave both empty to hide the Google button) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# --- YouTube Data API v3 (required for APP_ENV=production) ---
YOUTUBE_API_KEY=

# --- System owner: the first admin account, created by the worker on first start (password never overwritten) ---
SYSTEM_OWNER_USERNAME=superadmin
SYSTEM_OWNER_PASSWORD=CHANGE_ME

# --- Encrypts secrets saved from the admin pages (SMTP password). Losing it = re-enter those secrets. ---
SETTINGS_ENCRYPTION_KEY=CHANGE_ME

# --- Certificate signing (Ed25519) — a production key, never the dev one ---
CERT_SIGNING_ACTIVE_KID=CHANGE_ME
CERT_SIGNING_PRIVATE_KEY=CHANGE_ME
CERT_PUBLIC_KEYS='{}'
CERT_STORAGE_DIR=/data/certificates

# --- Email ---
# Fallback only: the system owner sets the real SMTP account in the admin pages (stored encrypted in the DB).
# smtp.invalid never resolves, so nothing is sent until that is done.
SMTP_URL=smtp://smtp.invalid:587
MAIL_FROM="UpskillReskill.RIETC <no-reply@CHANGE_ME>"
EMAIL_WEBHOOK_SECRET=
